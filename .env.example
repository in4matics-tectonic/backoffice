# Dev only: where the Vite proxy sends /v1 requests
BACKEND_URL=http://127.0.0.1:3000
# Production build only: absolute API base (leave empty when served behind the same origin)
VITE_API_URL=
# Optional override of the demo login shown on the login page (defaults are in src/components/Login.tsx)
VITE_DEMO_USER=adviseur
VITE_DEMO_PASSWORD=
